# Copy this file to .env (the install scripts do this for you) and fill in the values you need.

# Port for the status web page (default 3000)
PORT=3000

# Needed only for the "زيد" assistant command
OPENAI_API_KEY=

# Optional: full paths if these tools are not on your PATH
YTDLP_BIN=
DENO_BIN=

# Human-like typing before replies (can also be toggled in Messenger with: كتابة تشغيل / كتابة ايقاف)
TYPING_ENABLED=true
TYPING_MIN_MS=600
TYPING_MAX_MS=6000

# Secret required by POST /updatecookies (send it in the x-update-token header). Leave empty to disable that route.
UPDATE_COOKIES_TOKEN=
